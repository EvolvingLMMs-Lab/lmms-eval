# lmms-eval environment example
# Recommended lab default: OpenRouter for OpenAI-compatible judges and API models.
# Copy to .env and fill in secrets. Never commit .env.

# Judge backend (default openai → OpenAI-compatible chat completions)
API_TYPE=openai

# OpenRouter (recommended). Put the OpenRouter key in OPENAI_API_KEY.
# OPENAI_API_URL and OPENAI_API_BASE are aliases; either works.
OPENAI_API_KEY=sk-or-...
OPENAI_API_URL=https://openrouter.ai/api/v1
# OPENAI_API_BASE=https://openrouter.ai/api/v1

# Default judge model id on OpenRouter (tasks read MODEL_VERSION / JUDGE_MODEL_VERSION)
MODEL_VERSION=openai/gpt-4o-2024-11-20

# Optional: pin official OpenAI instead of the OpenRouter default
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Optional MiniMax-native judge (API_TYPE=minimax). For OpenRouter-hosted MiniMax use:
# API_TYPE=minimax
# MINIMAX_API_KEY=$OPENAI_API_KEY
# MINIMAX_API_URL=https://openrouter.ai/api/v1
# MINIMAX_MODEL=minimax/minimax-m3

# Optional Azure / TypeSafe Jev / local — unchanged
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# TYPESAFE_API_KEY=
