# lmms-eval environment example. Never commit secrets.
# OpenAI is the default; endpoint overrides are optional.
API_TYPE=openai
OPENAI_API_KEY=your-openai-key

# Models: OPENAI_API_BASE, then the OpenAI SDK's OPENAI_BASE_URL handling.
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_BASE_URL=http://localhost:8000/v1
# Judges: OPENAI_API_URL, then OPENAI_API_BASE, then official OpenAI.
# Set this explicitly when a local model shares the environment with a judge.
# OPENAI_API_URL=https://api.openai.com/v1

# Opt in to OpenRouter. Use a model id supported by your account.
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_URL=https://openrouter.ai/api/v1
# MODEL_VERSION=openai/gpt-4o-mini

# Optional OpenRouter-hosted MiniMax judge:
# API_TYPE=minimax
# MINIMAX_API_KEY=your-openrouter-key
# MINIMAX_API_URL=https://openrouter.ai/api/v1
# MINIMAX_MODEL=minimax/minimax-m3

# Optional Azure / TypeSafe Jev
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# TYPESAFE_API_KEY=
