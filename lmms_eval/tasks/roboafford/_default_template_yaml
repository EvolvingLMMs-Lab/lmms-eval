dataset_path: json
dataset_kwargs:
  data_files:
    test: https://huggingface.co/datasets/tyb197/RoboAfford-Eval/resolve/main/annotations_normxy.json
output_type: generate_until
doc_to_visual: !function utils.roboafford_doc_to_visual
doc_to_text: !function utils.roboafford_doc_to_text
doc_to_target: "answer"
process_results: !function utils.roboafford_process_results

metric_list:
  - metric: roboafford_accuracy
    aggregation: !function utils.roboafford_aggregate_overall
    higher_is_better: true
  - metric: object_affordance
    aggregation: !function utils.roboafford_aggregate_object_affordance
    higher_is_better: true
  - metric: object_reference
    aggregation: !function utils.roboafford_aggregate_object_reference
    higher_is_better: true
  - metric: spatial_affordance
    aggregation: !function utils.roboafford_aggregate_spatial_affordance
    higher_is_better: true

generation_kwargs:
  max_new_tokens: 256
  temperature: 0
  do_sample: false

metadata:
  version: 0.1
  source_dataset: tyb197/RoboAfford-Eval
